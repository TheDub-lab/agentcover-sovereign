include LICENSE
include README.md
include pyproject.toml

# Packaged default config (also shipped as wheel package-data)
recursive-include src/safety_protocol/data *.json

# Worked examples (developer-facing), not marketing assets
recursive-include examples *.py *.json

# Keep the source distribution lean: no marketing/promo assets, no root demo,
# no local state or build cruft.
exclude carrier_deck.html
exclude examples/loss_curve.png
exclude examples/loss_curve.svg
exclude sovereign_agent.py
exclude agent_capabilities.py
exclude agent_memory.json
exclude testnet_wallets.json
prune src/safety_protocol/__pycache__
prune src/safety_protocol.egg-info
global-exclude __pycache__
global-exclude *.py[cod]
